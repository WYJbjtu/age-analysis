    {
      "role": "section-heading",
      "text": "1 Shared aging,uneven regions",
      "css_pt": 33.999975,
      "x": 102.046875,
      "y": 808.796875,
      "width": 684.09375,
      "height": 105.453125,
      "right": 786.140625,
      "bottom": 914.25
    },
    {
      "role": "body",
      "text": "Both countries aged over 2000-2022, with Japan at a higher level. Yet national trajectories conceal broad regional variation. The complete 2022 distribution establishes differences within each country; it does not make a state equivalent to a prefecture or identify the causes of aging.",
      "css_pt": 24,
      "x": 102.046875,
      "y": 936.921875,
      "width": 684.09375,
      "height": 332.75,
      "right": 786.140625,
      "bottom": 1269.671875
    },
    {
      "role": "caption",
      "text": "Historical estimates, both sexes. A common national source shows the two trajectories; regional data are kept separate.",
      "css_pt": 20.000025,
      "x": 816.375,
      "y": 1372.515625,
      "width": 1114.953125,
      "height": 66.65625,
      "right": 1931.328125,
      "bottom": 1439.171875
    },
    {
      "role": "section-heading",
      "text": "2 Economic structure and aggregation",
